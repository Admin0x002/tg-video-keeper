# ===== Telegram API 凭证（必填）=====
# 申请地址：https://my.telegram.org → API development tools
API_ID=
API_HASH=

# ===== 目标备份频道（必填）=====
# 把媒体克隆到这个频道。格式：-100 + 频道 ID，例如 -1001234567890
# 获取方法见 README.md「配置说明 - 获取 Chat ID」
TARGET_CHAT_ID=

# ===== 来源聊天（监听白名单，逗号分隔）=====
# 'me' = 你的收藏夹（Saved Messages）
# 也可以加私密频道 ID，例如：me,-1009876543210
SOURCE_CHATS=me

# ===== 用户白名单（逗号分隔，你的 user id）=====
# 留空 = 仅依赖来源白名单保护；建议填你自己的 user id 进一步收紧
ALLOWED_USER_IDS=

# ===== 行为开关 =====
# 来源为收藏夹时，克隆成功后是否删除原转发消息（true=保持收藏夹干净）
DELETE_ORIGINAL_FROM_SAVED=true

# 克隆到目标频道时是否静默发送（不触发通知）
SILENT_SEND=true

# Session 文件名（默认 keeper，多账号可改）
SESSION_NAME=keeper

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
