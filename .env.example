# ===== Telegram API 凭证（必填）=====
# 申请地址：https://my.telegram.org → API development tools
API_ID=
API_HASH=

# ===== 目标备份频道（必填）=====
# 把收藏夹中的媒体克隆到这个频道。格式：-100 + 频道 ID，例如 -1001234567890
TARGET_CHAT_ID=

# ===== 行为开关 =====
# 克隆成功后是否删除收藏夹原消息（true=保持收藏夹干净）
DELETE_ORIGINAL_FROM_SAVED=true

# 克隆到目标频道时是否静默发送（不触发通知）
SILENT_SEND=true

# 收藏夹链接下载整体超时（秒）。大文件慢链路需留足时间。默认 3600s（1h）。
LINK_DOWNLOAD_TIMEOUT=3600

# 下载停滞超时（秒）：进度无任何进展超过此秒即取消跳过。
# 受限频道 download_media 进度回调永不触发，靠此快速判定挂起。默认 60s。
LINK_STALL_TIMEOUT=60

# 上传后是否保留本地临时文件（true=保留，方便用 ffmpeg/ffprobe 核对；
# false=上传后清理，保持干净）。默认 false。
KEEP_LOCAL_FILE_AFTER_UPLOAD=false

# ===== X(Twitter) 视频下载 =====
# 收到 x.com/twitter.com 视频链接消息时自动下载并上传到备份频道。
# cookies 文件路径(Netscape 格式)：私有推文/403 时才需要，公开推文无需。留空=不带 cookies。
X_COOKIES_FILE=
# X 下载整体超时(秒)。默认 3600。
X_DOWNLOAD_TIMEOUT=3600
# X 下载停滞超时(秒)：进度无进展超过此秒即取消。默认 60。
X_STALL_TIMEOUT=60

# ===== 视频压缩 =====
# 下载后是否按"码率=大小/时长"自动压缩再上传（仅视频）。true/false
COMPRESS_VIDEO=true
# 源码率(Mbps)超过此值才压；低于则跳过。200MB/1min≈26(压)，200MB/30min≈0.9(跳)
COMPRESS_BITRATE_THRESHOLD=6
# 甜点编码：CRF + 码率上限 + 预设。preset 越慢文件越小(veryfast/fast/medium)
COMPRESS_CRF=24
COMPRESS_MAXRATE=5M
COMPRESS_BUFSIZE=8M
COMPRESS_PRESET=veryfast
COMPRESS_AUDIO_BITRATE=128k
# 小于此大小(MB)不压缩
COMPRESS_MIN_SIZE_MB=20

# Session 文件名（默认 keeper，多账号可改）
SESSION_NAME=keeper

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
